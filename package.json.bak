{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "postinstall": "prisma generate",
    "prebuild": "npm run verify:deploy",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/verify-deploy.mjs --artifacts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:prisma-server": "tsc --noEmit --pretty false --skipLibCheck --module esnext --moduleResolution bundler --target es2022 src/server/prisma.ts src/server/workspaceNormalizationWorker.ts",
    "test:error-contract": "tsx --test scripts/safe-error-contract.test.ts scripts/auth-error-contract.test.ts",
    "test:deploy": "tsx --test scripts/deployment-contract.test.ts scripts/niche-scope-contract.test.ts scripts/platform-admin-authorization-contract.test.ts",
    "test:money-bank": "tsx --test scripts/payment-accounts-contract.test.ts",
    "test:prisma": "tsx --test scripts/prisma-adoption-contract.test.ts",
    "test:product-catalogue": "tsx --test scripts/product-catalogue-backup-contract.test.ts",
    "test:supabase-cron": "tsx --test scripts/supabase-cron-normalization-contract.test.ts",
    "test:normalized-read": "tsx --test scripts/normalized-workspace-read-contract.test.ts",
    "test:google-auth": "tsx --test scripts/google-auth-onboarding-contract.test.ts",
    "test:staff-google-invite": "tsx --test scripts/staff-google-invitation-contract.test.ts",
    "test:affiliate-google": "tsx --test scripts/affiliate-google-registration-contract.test.ts",
    "test:partner-capacity": "tsx --test scripts/partner-capacity-contract.test.ts",
    "test:super-admin-google-mfa": "tsx --test scripts/super-admin-google-mfa-contract.test.ts",
    "test:partner-dashboard": "tsx --test scripts/partner-dashboard-wiring-contract.test.ts",
    "test:security-hardening": "tsx --test scripts/security-hardening-contract.test.ts",
    "security:secrets": "node scripts/security-repository-audit.mjs"
    "i18n:gap": "node scripts/i18n-gap.mjs",
    "security:dependencies": "npm audit --audit-level=high --omit=dev",
    "test:performance-requests": "tsx --test scripts/performance-request-contract.test.ts",
    ""verify:source": "node scripts/verify-deploy.mjs && npm run security:secrets && npm run i18n:gap && npm run test:error-contract",
    "verify:deploy": "npm run verify:source && npm run lint:prisma-server && npm run test:deploy && npm run test:money-bank && npm run test:prisma && npm run test:product-catalogue && npm run test:supabase-cron && npm run test:normalized-read && npm run test:google-auth && npm run test:staff-google-invite && npm run test:affiliate-google && npm run test:partner-capacity && npm run test:super-admin-google-mfa && npm run test:partner-dashboard && npm run test:security-hardening && npm run test:performance-requests",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:pull": "prisma db pull",
    "seed:demo-branches": "tsx scripts/seed-demo-branches.ts",
    "test:database-capacity": "tsx scripts/database-capacity-test.ts --confirm-staging",
    "test": "vitest run src",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "8.16.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "8.15.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "7.9.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
